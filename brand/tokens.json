{
  "color": {
    "violet": "#5B2EFF",
    "violet-deep": "#3D17D6",
    "yellow": "#FFC92E",
    "ink": "#17132E",
    "paper": "#F3EFFF",
    "white": "#FFFFFF",
    "muted": "#4A4370",
    "muted-on-dark": "#CFC6EE",
    "lilac-200": "#DCD3FF",
    "lilac-300": "#C9BCFF",
    "mint": "#0E9F6E",
    "coral": "#E5432A"
  },
  "radius": { "sm": 12, "md": 16, "lg": 24, "pill": 999 },
  "outline": 2,
  "shadow": {
    "button": { "x": 5, "y": 5, "color": "ink" },
    "card": { "x": 8, "y": 8, "color": "ink" }
  },
  "font": {
    "display": {
      "family": "Bricolage Grotesque",
      "fallback": "system-ui, sans-serif",
      "files": { "800": "BricolageGrotesque-ExtraBold" }
    },
    "body": {
      "family": "DM Sans",
      "fallback": "system-ui, sans-serif",
      "files": { "400": "DMSans-Regular", "500": "DMSans-Medium", "700": "DMSans-Bold" }
    },
    "mono": {
      "family": "JetBrains Mono",
      "fallback": "ui-monospace, monospace",
      "files": { "500": "JetBrainsMono-Medium", "700": "JetBrainsMono-Bold" }
    }
  }
}
