<!-- Styles shared by passClaude's windows. Colours come from brand.xaml and fonts from ui.ps1, so every value here is a
     DynamicResource: this file is parsed on its own, before those resources are merged next to it. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Primary action: violet with an ink outline and a hard ink shadow, like a sticker. -->
  <Style x:Key="StickerButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource White}"/>
    <Setter Property="Background" Value="{DynamicResource Violet}"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontBody}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="MinHeight" Value="46"/>
    <Setter Property="Padding" Value="26,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Ring" CornerRadius="15" Margin="-5" BorderBrush="{DynamicResource Lilac300}" BorderThickness="3" Visibility="Collapsed"/>
            <Border CornerRadius="12" Background="{DynamicResource Ink}" Margin="4,4,-4,-4"/>
            <Border x:Name="Face" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Ink}"
                    BorderThickness="2" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource VioletDeep}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Face" Property="RenderTransform">
                <Setter.Value>
                  <TranslateTransform X="3" Y="3"/>
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Secondary action: white with an ink outline, no shadow. -->
  <Style x:Key="PlainButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="Background" Value="{DynamicResource White}"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontBody}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="MinHeight" Value="46"/>
    <Setter Property="Padding" Value="20,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Ring" CornerRadius="15" Margin="-5" BorderBrush="{DynamicResource Lilac300}" BorderThickness="3" Visibility="Collapsed"/>
            <Border x:Name="Face" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Ink}"
                    BorderThickness="2" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Paper}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The window's own close button in the custom title bar. -->
  <Style x:Key="TitleCloseButton" TargetType="Button">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Face" Background="Transparent" CornerRadius="0,13,0,0">
            <Path Data="M1 1L11 11M11 1L1 11" Stroke="{DynamicResource Ink}" StrokeThickness="1.4" Width="12" Height="12"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Paper}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Text fields: rounded, lilac outline that turns violet with a soft ring while typing. -->
  <Style x:Key="FieldBase" TargetType="Control">
    <Setter Property="Height" Value="46"/>
    <Setter Property="FontFamily" Value="{DynamicResource FontBody}"/>
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="Padding" Value="6,0"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="Background" Value="{DynamicResource White}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Lilac300}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  </Style>

  <Style x:Key="PcPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource FieldBase}">
    <Setter Property="CaretBrush" Value="{DynamicResource Violet}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Grid>
            <Border x:Name="Ring" CornerRadius="16" Margin="-4" Background="{DynamicResource Lilac200}" Visibility="Collapsed"/>
            <Border x:Name="Box" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Violet}"/>
              <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PcTextBox" TargetType="TextBox" BasedOn="{StaticResource FieldBase}">
    <Setter Property="CaretBrush" Value="{DynamicResource Violet}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid>
            <Border x:Name="Ring" CornerRadius="16" Margin="-4" Background="{DynamicResource Lilac200}" Visibility="Collapsed"/>
            <Border x:Name="Box" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Violet}"/>
              <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource FontBody}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Margin" Value="0,0,0,6"/>
  </Style>
</ResourceDictionary>
